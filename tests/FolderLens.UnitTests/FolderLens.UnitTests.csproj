<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="../../src/FolderLens.Infrastructure/FolderLens.Infrastructure.csproj"/>
  <ProjectReference Include="../../src/FolderLens.Scan.Worker/FolderLens.Scan.Worker.csproj" ReferenceOutputAssembly="false"/>
  <ProjectReference Include="../FolderLens.ScanFixture/FolderLens.ScanFixture.csproj" ReferenceOutputAssembly="false"/>
  <PackageReference Include="xunit"/>
  <PackageReference Include="xunit.runner.visualstudio"><PrivateAssets>all</PrivateAssets></PackageReference>
  <PackageReference Include="Microsoft.NET.Test.Sdk"/>
  <Compile Include="../../src/FolderLens.App/AppPaths.cs" Link="AppPaths.cs"/>
  <Compile Include="../../src/FolderLens.App/UserMessages.cs" Link="UserMessages.cs"/>
  <Compile Include="../../src/FolderLens.Media.Worker/BmffImageFormat.cs" Link="BmffImageFormat.cs"/>
 </ItemGroup>
 <Target Name="StageScanWorkerForIntegration" AfterTargets="Build">
  <ItemGroup><ScanWorkerFiles Include="../../src/FolderLens.Scan.Worker/bin/$(Configuration)/$(TargetFramework)/win-x64/**/*" Exclude="**/*.pdb"/></ItemGroup>
  <Copy SourceFiles="@(ScanWorkerFiles)" DestinationFiles="@(ScanWorkerFiles->'$(TargetDir)scan-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
 </Target>
</Project>
