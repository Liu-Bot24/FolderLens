<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Native: Windows 11. The window sits on Mica (set in code); navigation and the
       preview sit directly on it, the file list is a layered card, and controls use
       the stock Fluent templates with the user's system accent colour. -->
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
  <CornerRadius x:Key="AppearancePanelRadius">8</CornerRadius>
  <CornerRadius x:Key="AppearanceSidebarRadius">0</CornerRadius>
  <CornerRadius x:Key="AppearanceControlRadius">4</CornerRadius>
  <CornerRadius x:Key="AppearanceInputRadius">4</CornerRadius>
  <Thickness x:Key="AppearanceThumbnailBorder">0</Thickness>
  <Thickness x:Key="AppearanceViewSwitcherBorder">1</Thickness>
  <Thickness x:Key="AppearancePreviewPadding">10,10</Thickness>
  <Thickness x:Key="AppearancePreviewActionsMargin">0,5,0,6</Thickness>
  <Thickness x:Key="AppearancePreviewHeaderMargin">0,0,0,5</Thickness>
  <x:Double x:Key="AppearancePreviewActionHeight">32</x:Double>
  <x:Double x:Key="AppearanceFileNameSize">12</x:Double>
  <Style x:Key="AppearanceGridItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
    <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Thickness x:Key="AppearancePaneBorder">1</Thickness>
  <Thickness x:Key="AppearanceTreeMargin">0</Thickness>
  <Thickness x:Key="AppearancePreviewMargin">0</Thickness>
  <Thickness x:Key="AppearanceBrowserMargin">2,0,8,8</Thickness>
  <Thickness x:Key="AppearanceToolbarBorder">0</Thickness>
  <x:Double x:Key="AppearanceDividerOpacity">0</x:Double>
  <Thickness x:Key="AppearanceSidebarBorder">0</Thickness>
  <Thickness x:Key="AppearancePreviewBorder">0,1,0,0</Thickness>
  <CornerRadius x:Key="AppearanceThumbnailRadius">4</CornerRadius>
  <CornerRadius x:Key="AppearanceBadgeRadius">4</CornerRadius>
  <Thickness x:Key="MediaBadgeBorderThickness">0</Thickness>
  <SolidColorBrush x:Key="MediaBadgeBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="ViewerSurfaceBrush" Color="#20242B" />
  <Thickness x:Key="ViewerOverlayBorderThickness">1</Thickness>
  <CornerRadius x:Key="ViewerOverlayRadius">0</CornerRadius>
  <Thickness x:Key="ViewerOverlayMargin">0</Thickness>
  <x:Double x:Key="AppearanceAuroraOpacity">0</x:Double>
  <Color x:Key="AppearanceAuroraPrimaryColor">Transparent</Color>
  <Color x:Key="AppearanceAuroraPrimaryFadeColor">Transparent</Color>
  <Color x:Key="AppearanceAuroraSecondaryColor">Transparent</Color>
  <Color x:Key="AppearanceAuroraSecondaryFadeColor">Transparent</Color>
  <Color x:Key="AppearanceAuroraTertiaryColor">Transparent</Color>
  <Color x:Key="AppearanceAuroraTertiaryFadeColor">Transparent</Color>
  <Style x:Key="VideoPosterPlayStyle" TargetType="Button">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="56" MaxHeight="56"><Border Width="56" Height="56" CornerRadius="28" Background="#B820242B"><FontIcon Glyph="&#xE768;" FontSize="24" Foreground="White" /></Border></Viewbox></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ShellBackgroundBrush" Color="Transparent" />
      <!-- Mica's own fallback colour, used where the material is unavailable. -->
      <SolidColorBrush x:Key="BrowserChromeBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="AppearanceSidebarBrush" Color="Transparent" />
      <SolidColorBrush x:Key="BrowserInsetBrush" Color="Transparent" />
      <SolidColorBrush x:Key="AppearancePathBrush" Color="{ThemeResource TextFillColorSecondary}" />
      <SolidColorBrush x:Key="BrowserLineBrush" Color="#E5E5E5" />
      <SolidColorBrush x:Key="AppearanceChromeLineBrush" Color="#14000000" />
      <SolidColorBrush x:Key="AppearancePaneRimBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="ThumbnailMatBrush" Color="#0A000000" />
      <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="#E820242B" />
      <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ScopeFillBrush" Color="#E8F1FA" />
      <SolidColorBrush x:Key="BrowserWarningBrush" Color="#856100" />
      <SolidColorBrush x:Key="AppearanceFilterBrush" Color="#856100" />
      <Color x:Key="BrowserDetailsSelectedColor">#CFE4FF</Color>
      <Color x:Key="BrowserDetailsHoverColor">#BDD9FA</Color>
      <Color x:Key="BrowserDetailsPressedColor">#A9CCF5</Color>
      <SolidColorBrush x:Key="ViewerOverlayBrush" Color="#F9F9F9" />
      <SolidColorBrush x:Key="ViewerOverlayBorderBrush" Color="#0F000000" />
      <StaticResource x:Key="ViewSwitcherTrackBrush" ResourceKey="ControlFillColorDefaultBrush" />
      <Color x:Key="ViewSwitcherOffColor">#B3FFFFFF</Color>
      <Color x:Key="ViewSwitcherOffHoverColor">#80F9F9F9</Color>
      <StaticResource x:Key="ViewSwitcherOnColor" ResourceKey="SystemAccentColorDark1" />
      <Color x:Key="ViewSwitcherOnTextColor">#FFFFFF</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ShellBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="BrowserChromeBrush" Color="#202020" />
      <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="#4C3A3A3A" />
      <SolidColorBrush x:Key="AppearanceSidebarBrush" Color="Transparent" />
      <SolidColorBrush x:Key="BrowserInsetBrush" Color="Transparent" />
      <SolidColorBrush x:Key="AppearancePathBrush" Color="{ThemeResource TextFillColorSecondary}" />
      <SolidColorBrush x:Key="BrowserLineBrush" Color="#3D3D3D" />
      <SolidColorBrush x:Key="AppearanceChromeLineBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="AppearancePaneRimBrush" Color="#33000000" />
      <SolidColorBrush x:Key="ThumbnailMatBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="#E820242B" />
      <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ScopeFillBrush" Color="#263D52" />
      <SolidColorBrush x:Key="BrowserWarningBrush" Color="#EBC85A" />
      <SolidColorBrush x:Key="AppearanceFilterBrush" Color="#EBC85A" />
      <Color x:Key="BrowserDetailsSelectedColor">#174A78</Color>
      <Color x:Key="BrowserDetailsHoverColor">#205E94</Color>
      <Color x:Key="BrowserDetailsPressedColor">#2469A3</Color>
      <SolidColorBrush x:Key="ViewerOverlayBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="ViewerOverlayBorderBrush" Color="#14FFFFFF" />
      <StaticResource x:Key="ViewSwitcherTrackBrush" ResourceKey="ControlFillColorDefaultBrush" />
      <Color x:Key="ViewSwitcherOffColor">#0FFFFFFF</Color>
      <Color x:Key="ViewSwitcherOffHoverColor">#15FFFFFF</Color>
      <StaticResource x:Key="ViewSwitcherOnColor" ResourceKey="SystemAccentColorLight2" />
      <Color x:Key="ViewSwitcherOnTextColor">#000000</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <x:Double x:Key="AppearanceDividerOpacity">1</x:Double>
      <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AppearancePathBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="BrowserChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BrowserInsetBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BrowserLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppearanceChromeLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppearancePaneRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ThumbnailMatBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ScopeFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BrowserWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppearanceFilterBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppearanceSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ViewerOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ViewerOverlayBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ViewSwitcherTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
