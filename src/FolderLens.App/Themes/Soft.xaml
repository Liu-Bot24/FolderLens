<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
  <CornerRadius x:Key="AppearancePanelRadius">20</CornerRadius>
  <CornerRadius x:Key="AppearanceSidebarRadius">16</CornerRadius>
  <CornerRadius x:Key="AppearanceControlRadius">8</CornerRadius>
  <Thickness x:Key="AppearancePaneBorder">0</Thickness>
  <Thickness x:Key="AppearanceTreeMargin">8,4,0,4</Thickness>
  <Thickness x:Key="AppearancePreviewMargin">8,4,8,4</Thickness>
  <Thickness x:Key="AppearanceBrowserMargin">2,4,8,4</Thickness>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BrowserChromeBrush" Color="#E3E7EF" />
      <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrowserLineBrush" Color="#D2D8E4" />
      <SolidColorBrush x:Key="ThumbnailMatBrush" Color="#F1F3F9" />
      <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="#E820242B" />
      <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ScopeFillBrush" Color="#E3E1F8" />
      <SolidColorBrush x:Key="BrowserWarningBrush" Color="#795500" />
      <Color x:Key="BrowserDetailsSelectedColor">#E3E1F8</Color>
      <Color x:Key="BrowserDetailsHoverColor">#D6D2F2</Color>
      <Color x:Key="BrowserDetailsPressedColor">#C8C1ED</Color>
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1F2430" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#566174" />
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#566174" />
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#E5EAF4" />
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#D7DEEC" />
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#C9D2E4" />
      <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3D3AC0" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#524FE0" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3D3AC0" />
      <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F1F3F9" />
      <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#E5EAF4" />
      <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1814161B" />
      <Color x:Key="SystemAccentColor">#3D3AC0</Color>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
      <SolidColorBrush x:Key="AppearanceSidebarBrush" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BrowserChromeBrush" Color="#191C24" />
      <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="#252A35" />
      <SolidColorBrush x:Key="BrowserLineBrush" Color="#434B5D" />
      <SolidColorBrush x:Key="ThumbnailMatBrush" Color="#303746" />
      <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="#E820242B" />
      <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ScopeFillBrush" Color="#38345A" />
      <SolidColorBrush x:Key="BrowserWarningBrush" Color="#EBC85A" />
      <Color x:Key="BrowserDetailsSelectedColor">#403966</Color>
      <Color x:Key="BrowserDetailsHoverColor">#4B4378</Color>
      <Color x:Key="BrowserDetailsPressedColor">#584D8B</Color>
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F0F2F7" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B1BACB" />
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#B1BACB" />
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#353D4E" />
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#414B60" />
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4C5770" />
      <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#252A35" />
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B9B0FF" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#CAC3FF" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B9B0FF" />
      <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#303746" />
      <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#353D4E" />
      <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#20FFFFFF" />
      <Color x:Key="SystemAccentColor">#B9B0FF</Color>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
      <SolidColorBrush x:Key="AppearanceSidebarBrush" Color="#252A35" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <Thickness x:Key="AppearancePaneBorder">1</Thickness>
      <SolidColorBrush x:Key="BrowserChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BrowserLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ThumbnailMatBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MediaBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ScopeFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="BrowserWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AppearanceSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>