  <!-- Frosted play button. The whole surface remains the click target, exactly as
       in the other appearances; only the centre plate is restyled. -->
  <Style x:Key="VideoPosterPlayStyle" TargetType="Button">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="Dim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="Dim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="Dim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Dim" Background="#2E000000" Opacity="0" />
            <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="84" MaxHeight="84">
              <Grid Width="84" Height="84" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="PlateScale" /></Grid.RenderTransform>
                <Ellipse x:Name="Glow" Opacity="0">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#998AA8FF" Offset="0.5" />
                      <GradientStop Color="#008AA8FF" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Border Width="60" Height="60" CornerRadius="30" BorderThickness="1" Background="{ThemeResource VideoPlayPlateBrush}" BorderBrush="{ThemeResource VideoPlayRimBrush}">
                  <FontIcon Glyph="&#xE768;" FontSize="24" Foreground="White" Margin="3,0,0,0" />
                </Border>
              </Grid>
            </Viewbox>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
